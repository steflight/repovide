# Aucune donnée sensible ici. Les vrais secrets viennent du coffre au runtime.
PORT=3000

# --- Canal IMAP (lecture seule) ---
# Renseigne ces 3 lignes pour activer l'ingestion. Vides = mode health-only.
# Utilise un MOT DE PASSE D'APPLICATION dédié (pas ton mot de passe principal).
# IMAP_HOST=imap.gmail.com        # ex: imap.gmail.com, imap.fastmail.com, imap.ionos.fr…
# IMAP_USER=moi@exemple.com
# IMAP_PASSWORD=xxxx-xxxx-xxxx     # mot de passe d'application
# IMAP_PORT=993                    # défaut 993
# IMAP_TLS=true                    # défaut true ; mettre false seulement en clair (déconseillé)
# IMAP_POLL_MS=60000               # intervalle de relève (min 15000)
# IMAP_FETCH_LIMIT=25              # nb de derniers messages relus à chaque passe

# Gmail via OAuth (lot ultérieur) — à remplir plus tard :
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# (session Baileys WhatsApp : gérée chiffrée, hors .env)
